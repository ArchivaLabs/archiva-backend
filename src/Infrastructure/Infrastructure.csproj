<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Archiva.Infrastructure</RootNamespace>
    <AssemblyName>Archiva.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Aspire.Azure.Storage.Queues" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="PdfSharpCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- Registers the Entra ID authentication providers for Microsoft.Data.SqlClient.
         Without it, the managed-identity connection string that azd generates
         ("Authentication=Active Directory Default") fails at connect time with
         "Cannot find an authentication provider for 'ActiveDirectoryDefault'".
         SqlClient itself is pinned to the same version: EF Core pulls in 7.0.1
         transitively, and the version skew makes SqlAuthenticationProviderManager
         resolve the provider constructor twice ("Ambiguous match found"). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
